# Anthropic API — generates the voice agent's system prompt from the business info form
ANTHROPIC_API_KEY=

# Vapi — the voice AI platform that powers the live browser call.
# Get your Public Key from the Vapi dashboard: Settings -> API Keys.
# This one is safe to expose to the browser (that's why it's NEXT_PUBLIC_).
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Your Calendly booking link, shown as a CTA after the demo call ends.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link

# Public app URL (used if/when you add more redirect-based flows later)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase - logs every demo submission (email + business info) as a lead.
# Get these from your Supabase project: Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY is server-only, never expose it to the browser
# (that's why it's NOT prefixed with NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
